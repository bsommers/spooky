{
  "name": "spooky",
  "version": "0.1.0",
  "description": "Dual-axis ghostwriter: source-author voice for a target audience persona, behind a pluggable filter pipeline.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "ghostwriter": "dist/src/cli/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "scripts/verify.sh",
    "calibrate": "tsc -p tsconfig.build.json && node dist/scripts/calibrate.js",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build && npm run ui:build && node scripts/check-ui-dist.mjs",
    "ui:install": "npm --prefix ui ci",
    "ui:build": "npm --prefix ui run build",
    "ui:test": "npm --prefix ui test",
    "ui:e2e": "npm run build && npm run ui:build && npm --prefix ui run test:e2e",
    "ui:e2e:container": "npm run build && npm run ui:build && ui/scripts/e2e-container.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "^12.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.12.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "!dist/scripts",
    "ui/dist"
  ]
}
